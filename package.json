{
  "name": "link-in-bio",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "next start",
    "build": "next build",
    "dev": "next dev",
    "typecheck": "tsc --noEmit",
    "format": "ultracite fix",
    "lint": "ultracite check",
    "bump-deps": "bunx npm-check-updates --deep -u && bun install",
    "bump-ui": "bunx --bun shadcn add --all --overwrite && bunx --bun shadcn migrate --yes radix",
    "clean": "git clean -xdf node_modules"
  },
  "dependencies": {
    "@databuddy/sdk": "^2.4.20",
    "@t3-oss/env-nextjs": "^0.13.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.1",
    "motion": "^12.40.0",
    "next": "16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "ultracite": "7.8.1"
  },
  "overrides": {
    "brace-expansion": "5.0.6",
    "postcss": "8.5.14"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ]
